# Contexta Py — environment template
# Copy to .env and fill real values:  cp .env.example .env
# NEVER commit .env. On Windows PowerShell:  Copy-Item .env.example .env

# --- Core ---
APP_ENV=development
LOG_LEVEL=INFO
SECRET_KEY=change-me-generate-with-secrets-token-urlsafe-48
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000

# --- Postgres ---
POSTGRES_USER=contexta
POSTGRES_PASSWORD=change-me
POSTGRES_DB=contexta
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://contexta:change-me@postgres:5432/contexta

# --- Redis / Arq ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
ARQ_JOB_TIMEOUT=1800

# --- Qdrant ---
# NOTE: this URL is used from inside the Docker network.
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=contexta_chunks
QDRANT_API_KEY=

# --- MinIO / S3 ---
# Internal endpoint: used by the app/worker containers on the compose network.
MINIO_ENDPOINT=http://minio:9000
# Browser-reachable endpoint. Presigned URLs are signed against THIS host, so
# the signature still validates when the browser follows the 302 redirect.
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=contexta
MINIO_SECRET_KEY=change-me
MINIO_BUCKET=contexta
MINIO_SECURE=false
MINIO_PRESIGN_EXPIRES=3600

# --- Embeddings ---
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
EMBEDDING_DIM=768
EMBEDDING_BATCH_SIZE=32
EMBEDDING_BACKEND=fastembed
MODEL_CACHE_DIR=/models

# --- Parser / chunking ---
PARSER=pymupdf
CHUNK_PARENT_SIZE=2000
CHUNK_CHILD_SIZE=400
CHUNK_CHILD_OVERLAP=60

# --- Retrieval ---
RETRIEVAL_CANDIDATES=40
RETRIEVAL_TOP_K=8
RERANK_TOP_K=5
RERANK_MIN_SCORE=0.0
RERANK_MODEL=ms-marco-MiniLM-L-12-v2
GRADER_THRESHOLD=70

# --- LLM (Groq via OpenAI SDK) ---
GROQ_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1500
LLM_BACKEND=groq

# --- Web search ---
TAVILY_API_KEY=
WEB_SEARCH_ENABLED=true
WEB_SEARCH_MAX_RESULTS=5

# --- TTS ---
TTS_ENABLED=true
TTS_VOICE=en-US-AriaNeural

# --- Ingestion ---
WORKER_DISPATCH_ENABLED=true
MODEL_DOWNLOAD_ON_STARTUP=true